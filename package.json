  "version": "1.0.0",
  "type": "module",
  "description": "MARKET//30 — a browser-based virtual stock trading game. 30 days. ₩1,000,000. One market.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
